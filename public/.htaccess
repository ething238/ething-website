# React Router (single-page app): send unknown paths to index.html
# Needed on Apache (typical Hostinger shared hosting) so /about_us etc. work on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # The eight exported landing pages already POST to this extensionless URL.
  # Keep the request body/method; never send this API request to the SPA.
  RewriteRule ^api/hire-developers/?$ api/hire-developers.php [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
