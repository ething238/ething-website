# Serve route-specific prerendered HTML on Hostinger/Apache.
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permanently consolidate the bare domain onto the preferred HTTPS www host.
  # REQUEST_URI preserves the path; the original query string is retained.
  RewriteCond %{HTTP_HOST} ^ethingsolutions\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://www.ethingsolutions.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+home\.html(?:[?\s]) [NC]
  RewriteRule ^home\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Match the canonical slashless URLs in React and the sitemap.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Legacy route aliases remain permanent redirects.
  RewriteRule ^about/?$ /about_us [R=301,L]
  RewriteRule ^staffing-services/?$ /staffing_services [R=301,L]
  RewriteRule ^ai-staff-augmentation/?$ /ai_staff_augmentation [R=301,L]

  RewriteRule ^$ index.html [L]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Leave real assets, PHP APIs and directories alone. Unknown paths are 404s.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>
