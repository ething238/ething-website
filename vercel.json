{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ethingsolutions.com"
        }
      ],
      "destination": "https://www.ethingsolutions.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sap-services",
      "destination": "/sap-services/index.html"
    },
    {
      "source": "/ai_staff_augmentation",
      "destination": "/ai_staff_augmentation/index.html"
    },
    {
      "source": "/website-development",
      "destination": "/website-development/index.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
